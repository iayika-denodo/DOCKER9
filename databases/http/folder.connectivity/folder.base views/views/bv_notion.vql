                            )
                        )
                    ),
                    name = 'Name' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        title = 'title' : ARRAY OF (
                            title = 'title' : REGISTER OF (
