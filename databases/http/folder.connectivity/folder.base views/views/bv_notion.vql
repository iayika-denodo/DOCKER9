# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JSON ds_notion
    FOLDER = '/connectivity/base views'
    DATASOURCENAME=ds_notion
    TUPLEROOT '/JSONFile'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' POST '${databases.http.folder.connectivity.folder.base views.views.json.ds_notion.ROUTE.HTTP.URL}'
    OUTPUTSCHEMA (jsonfile = 'JSONFile' : REGISTER OF (
        object = 'object' : 'java.lang.String',
        results = 'results' : ARRAY OF (
            results = 'results' : REGISTER OF (
                object = 'object' : 'java.lang.String',
                id = 'id' : 'java.lang.String',
                created_time = 'created_time' : 'java.lang.String',
                last_edited_time = 'last_edited_time' : 'java.lang.String',
                created_by = 'created_by' : REGISTER OF (
                    object = 'object' : 'java.lang.String',
                    id = 'id' : 'java.lang.String'
                ),
                last_edited_by = 'last_edited_by' : REGISTER OF (
                    object = 'object' : 'java.lang.String',
                    id = 'id' : 'java.lang.String'
                ),
                cover = 'cover' : 'java.lang.String',
                icon = 'icon' : 'java.lang.String',
                parent = 'parent' : REGISTER OF (
                    type = 'type' : 'java.lang.String',
                    database_id = 'database_id' : 'java.lang.String'
                ),
                in_trash = 'in_trash' : 'java.lang.String',
                is_locked = 'is_locked' : 'java.lang.String',
                properties = 'properties' : REGISTER OF (
                    linkeditems_0 = 'Linked Items' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        relation = 'relation' : ARRAY OF (
                            relation = 'relation' : REGISTER OF (
                                field_0 = 'field_0' : 'java.lang.String'
                            )
                        ),
                        has_more = 'has_more' : 'java.lang.String'
                    ),
                    countdown = 'Countdown' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        formula = 'formula' : REGISTER OF (
                            type = 'type' : 'java.lang.String',
                            string = 'string' : 'java.lang.String'
                        )
                    ),
                    assignee = 'Assignee' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        people = 'people' : ARRAY OF (
                            people = 'people' : REGISTER OF (
                                field_0 = 'field_0' : 'java.lang.String'
                            )
                        )
                    ),
                    linkednotes_0 = 'Linked Notes' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        relation = 'relation' : ARRAY OF (
                            relation = 'relation' : REGISTER OF (
                                field_0 = 'field_0' : 'java.lang.String'
                            )
                        ),
                        has_more = 'has_more' : 'java.lang.String'
                    ),
                    relatedtasks_0 = 'Related Tasks' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        relation = 'relation' : ARRAY OF (
                            relation = 'relation' : REGISTER OF (
                                field_0 = 'field_0' : 'java.lang.String'
                            )
                        ),
                        has_more = 'has_more' : 'java.lang.String'
                    ),
                    location = 'Location' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        rich_text = 'rich_text' : ARRAY OF (
                            rich_text = 'rich_text' : REGISTER OF (
                                field_0 = 'field_0' : 'java.lang.String'
                            )
                        )
                    ),
                    extrainfo_0 = 'Extra Info' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        rich_text = 'rich_text' : ARRAY OF (
                            rich_text = 'rich_text' : REGISTER OF (
                                type = 'type' : 'java.lang.String',
                                text = 'text' : REGISTER OF (
                                    content = 'content' : 'java.lang.String',
                                    link = 'link' : 'java.lang.String'
                                ),
                                annotations = 'annotations' : REGISTER OF (
                                    bold = 'bold' : 'java.lang.String',
                                    italic = 'italic' : 'java.lang.String',
                                    strikethrough = 'strikethrough' : 'java.lang.String',
                                    underline = 'underline' : 'java.lang.String',
                                    code = 'code' : 'java.lang.String',
                                    color = 'color' : 'java.lang.String'
                                ),
                                plain_text = 'plain_text' : 'java.lang.String',
                                href = 'href' : 'java.lang.String'
                            )
                        )
                    ),
                    date = 'Date' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        date = 'date' : REGISTER OF (
                            start = 'start' : 'java.lang.String',
                            end = 'end' : 'java.lang.String',
                            time_zone = 'time_zone' : 'java.lang.String'
                        )
                    ),
                    type = 'Type' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        select_0 = 'select' : REGISTER OF (
                            id = 'id' : 'java.lang.String',
                            name = 'name' : 'java.lang.String',
                            color = 'color' : 'java.lang.String'
                        )
                    ),
                    status = 'Status' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
                        type = 'type' : 'java.lang.String',
                        status = 'status' : REGISTER OF (
                            id = 'id' : 'java.lang.String',
                            name = 'name' : 'java.lang.String',
                            color = 'color' : 'java.lang.String'
                        )
                    ),
                    people = 'People' : REGISTER OF (
                        id = 'id' : 'java.lang.String',
