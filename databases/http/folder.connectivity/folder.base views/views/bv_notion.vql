                                text = 'text' : REGISTER OF (
                                    content = 'content' : 'java.lang.String',
                                    link = 'link' : 'java.lang.String'
                                ),
                                annotations = 'annotations' : REGISTER OF (
                                    bold = 'bold' : 'java.lang.String',
                                    italic = 'italic' : 'java.lang.String',
                                    strikethrough = 'strikethrough' : 'java.lang.String',
                                    underline = 'underline' : 'java.lang.String',
                                    code = 'code' : 'java.lang.String',
                                    color = 'color' : 'java.lang.String'
                                ),
                                plain_text = 'plain_text' : 'java.lang.String',
                                href = 'href' : 'java.lang.String'
                            )
                        )
                    )
                ),
                url = 'url' : 'java.lang.String',
                public_url = 'public_url' : 'java.lang.String',
                archived = 'archived' : 'java.lang.String'
