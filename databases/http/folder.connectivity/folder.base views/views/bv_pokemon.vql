# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JSON pokemon
    FOLDER = '/connectivity/base views'
    DATASOURCENAME=ds_pokemon
    TUPLEROOT '/JSONFile/types'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.http.folder.connectivity.folder.base views.views.json.pokemon.ROUTE.HTTP.URL}'
    OUTPUTSCHEMA (jsonfile = 'JSONFile' : REGISTER OF (
        abilities = 'abilities' : ARRAY OF (
            abilities = 'abilities' : REGISTER OF (
                ability = 'ability' : REGISTER OF (
                    name = 'name' : 'java.lang.String',
                    url = 'url' : 'java.lang.String'
                ),
                is_hidden = 'is_hidden' : 'java.lang.String',
                slot = 'slot' : 'java.lang.Integer'
            )
        ),
        base_experience = 'base_experience' : 'java.lang.Integer',
        cries = 'cries' : REGISTER OF (
