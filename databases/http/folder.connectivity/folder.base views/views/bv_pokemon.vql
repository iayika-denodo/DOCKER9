                            url = 'url' : 'java.lang.String'
                        )
                    )
                )
            )
        ),
        id = 'id' : 'java.lang.Integer',
        is_default = 'is_default' : 'java.lang.String',
        location_area_encounters = 'location_area_encounters' : 'java.lang.String',
        moves = 'moves' : ARRAY OF (
