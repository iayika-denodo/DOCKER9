# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE CUSTOM ds_custom_test
    FOLDER = '/connectivity/data sources'
    CLASSNAME='com.denodo.vdb.contrib.wrapper.xls.ExcelWrapper';

CREATE OR REPLACE WRAPPER CUSTOM ds_custom_test
    FOLDER = '/connectivity/data sources'
    DATASOURCENAME=ds_custom_test
    PARAMETERS (
      'Type of file' = 'Excel 2007 or later (*.xlsx)',
      'File location' = ROUTE LOCAL 'LocalConnection' '${databases.http.folder.connectivity.folder.data sources.views.custom.ds_custom_test.File location.ROUTE.LOCAL.PATH}',
      'Extract data from all sheets' = false,
      'Extract sheet name as a new column' = false,
      'Has headers' = true,
      'Stream tuples' = true
    )
    OUTPUTSCHEMA (
        test = 'test' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE,
        other = 'other' : 'java.lang.Integer' (OPT) (sourcetypeid='4')  SORTABLE,
        double_space = 'double_space' : 'java.lang.String' (OPT) (sourcetypeid='12')  SORTABLE
    );

