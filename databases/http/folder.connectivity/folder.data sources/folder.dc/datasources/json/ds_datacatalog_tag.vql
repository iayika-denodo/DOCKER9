# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE JSON ds_datacatalog_tag
    FOLDER = '/connectivity/data sources/dc'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.http.folder.connectivity.folder.data sources.folder.dc.datasources.json.ds_datacatalog_tag.ROUTE.HTTP.URL}'
 AUTHENTICATION BASIC ( 
      USER '${databases.http.folder.connectivity.folder.data sources.folder.dc.datasources.json.ds_datacatalog_tag.ROUTE.HTTP.USER}'
      PASSWORD '${databases.http.folder.connectivity.folder.data sources.folder.dc.datasources.json.ds_datacatalog_tag.ROUTE.HTTP.PASSWORD}' ${databases.http.folder.connectivity.folder.data sources.folder.dc.datasources.json.ds_datacatalog_tag.ROUTE.HTTP.PASSWORD.ENCRYPTED} )
    PROXY OFF;

