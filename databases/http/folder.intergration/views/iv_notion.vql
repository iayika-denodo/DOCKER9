CREATE OR REPLACE VIEW iv_notion FOLDER = '/intergration' AS SELECT bv_notion.object AS object, bv_notion.results AS results, bv_notion.next_cursor AS next_cursor, bv_notion.has_more AS has_more, bv_notion.type AS type, bv_notion.page_or_database AS page_or_database, bv_notion.request_id AS request_id FROM bv_notion;

ALTER VIEW iv_notion
 LAYOUT (bv_notion = [20, 20, 200, 200]);

