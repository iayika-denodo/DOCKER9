CREATE OR REPLACE ASSOCIATION bv_bakehouse_sales_suppliers_sql_bv_bakehouse_sales_franchises REFERENTIAL CONSTRAINT 
FOLDER = '/associations'
    ENDPOINT bv_bakehouse_sales_franchises bv_bakehouse_sales_suppliers PRINCIPAL (0,1)
    ENDPOINT bv_bakehouse_sales_suppliers bv_bakehouse_sales_franchises (0,1)
    ADD MAPPING supplierid=supplierid;

ALTER ASSOCIATION bv_bakehouse_sales_suppliers_sql_bv_bakehouse_sales_franchises
 LAYOUT (bv_bakehouse_sales_suppliers = [120, 165, 200, 200], bv_bakehouse_sales_franchises = [1017, 22, 200, 200]);

