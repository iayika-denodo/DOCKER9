# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE WRAPPER JDBC bv_bakehouse_media_gold_reviews_chunked
    FOLDER = '/connectivity/base views/databricks'
    DATASOURCENAME=ds_databricks
    CATALOGNAME='${databases.sql.folder.connectivity.folder.base views.folder.databricks.views.jdbc.bv_bakehouse_media_gold_reviews_chunked.CATALOGNAME}' 
    SCHEMANAME='${databases.sql.folder.connectivity.folder.base views.folder.databricks.views.jdbc.bv_bakehouse_media_gold_reviews_chunked.SCHEMANAME}' 
    RELATIONNAME='media_gold_reviews_chunked' 
    OUTPUTSCHEMA (
        franchiseid = 'franchiseID' :'java.lang.Integer' (OPT) (sourcetypedecimals='0', sourcetyperadix='10', sourcetypesize='10', description='', sourcetypeid='4', sourcetypename='INT')  SORTABLE,
        review_date = 'review_date' :'java.time.LocalDateTime' (OPT) (sourcetypedecimals='9', sourcetyperadix='0', sourcetypesize='29', description='', sourcetypeid='93', sourcetypename='TIMESTAMP')  SORTABLE,
        chunked_text = 'chunked_text' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='255', description='', sourcetypeid='12', sourcetypename='STRING')  SORTABLE,
        chunk_id = 'chunk_id' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='255', description='', sourcetypeid='12', sourcetypename='STRING')  SORTABLE,
        review_uri = 'review_uri' :'java.lang.String' (OPT) (sourcetypedecimals='0', sourcetyperadix='0', sourcetypesize='255', description='', sourcetypeid='12', sourcetypename='STRING')  SORTABLE
    );

CREATE OR REPLACE TABLE bv_bakehouse_media_gold_reviews_chunked I18N us_pst (
        franchiseid:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = ''),
        review_date:timestamp (sourcetypeid = '93', sourcetyperadix = '0', sourcetypedecimals = '9', sourcetypesize = '29', description = ''),
        chunked_text:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '255', description = ''),
        chunk_id:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '255', description = ''),
        review_uri:text (sourcetypeid = '12', sourcetyperadix = '0', sourcetypedecimals = '0', sourcetypesize = '255', description = '')
    )
    FOLDER = '/connectivity/base views/databricks'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_bakehouse_media_gold_reviews_chunked(
        I18N us_pst
        CONSTRAINTS (
             ADD franchiseid (any) OPT ANY
             ADD review_date (any) OPT ANY
             ADD chunked_text (any) OPT ANY
             ADD chunk_id (any) OPT ANY
             ADD review_uri (any) OPT ANY
        )
        OUTPUTLIST (chunk_id, chunked_text, franchiseid, review_date, review_uri
        )
        WRAPPER (jdbc bv_bakehouse_media_gold_reviews_chunked)
    );

