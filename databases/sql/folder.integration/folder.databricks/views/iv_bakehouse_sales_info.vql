CREATE OR REPLACE VIEW iv_bakehouse_sales_info FOLDER = '/integration/databricks' AS SELECT bv_bakehouse_sales_customers.customerid AS customerid, bv_bakehouse_sales_transactions.transactionid AS transactionid, bv_bakehouse_sales_customers.first_name AS first_name, bv_bakehouse_sales_customers.last_name AS last_name, bv_bakehouse_sales_customers.email_address AS email_address, bv_bakehouse_sales_customers.phone_number AS phone_number, bv_bakehouse_sales_customers.address AS address, bv_bakehouse_sales_customers.city AS city, bv_bakehouse_sales_customers.state AS state, bv_bakehouse_sales_customers.country AS country, bv_bakehouse_sales_customers.continent AS continent, bv_bakehouse_sales_customers.postal_zip_code AS postal_zip_code, bv_bakehouse_sales_customers.gender AS gender, bv_bakehouse_sales_transactions.datetime AS datetime, bv_bakehouse_sales_transactions.product AS product, bv_bakehouse_sales_transactions.quantity AS quantity, bv_bakehouse_sales_transactions.unitprice AS unitprice, bv_bakehouse_sales_transactions.totalprice AS totalprice, bv_bakehouse_sales_transactions.paymentmethod AS paymentmethod, bv_bakehouse_sales_transactions.cardnumber AS cardnumber, bv_bakehouse_sales_franchises.franchiseid AS franchiseid, bv_bakehouse_sales_franchises.name AS franchisename, bv_bakehouse_sales_franchises.district AS franchisedistrict, bv_bakehouse_sales_franchises.zipcode AS franchisezipcode, bv_bakehouse_sales_franchises.size AS franchisesize, bv_bakehouse_sales_franchises.longitude AS franchiselongitude, bv_bakehouse_sales_franchises.latitude AS franchiselatitude, bv_bakehouse_sales_suppliers.supplierid AS supplierid, bv_bakehouse_sales_suppliers.name AS suppliername, bv_bakehouse_sales_suppliers.ingredient AS supplieringredient, bv_bakehouse_sales_suppliers.city AS suppliercity, bv_bakehouse_sales_suppliers.size AS suppliersize, bv_bakehouse_sales_suppliers.approved AS supplierapproved FROM ((bv_bakehouse_sales_transactions AS bv_bakehouse_sales_transactions INNER JOIN bv_bakehouse_sales_franchises AS bv_bakehouse_sales_franchises ON bv_bakehouse_sales_transactions.franchiseid = bv_bakehouse_sales_franchises.franchiseid ) INNER JOIN bv_bakehouse_sales_customers AS bv_bakehouse_sales_customers ON bv_bakehouse_sales_transactions.customerid = bv_bakehouse_sales_customers.customerid ) INNER JOIN bv_bakehouse_sales_suppliers AS bv_bakehouse_sales_suppliers ON bv_bakehouse_sales_franchises.supplierid = bv_bakehouse_sales_suppliers.supplierid ;

ALTER VIEW iv_bakehouse_sales_info
 LAYOUT (bv_bakehouse_sales_transactions = [368, 43, 200, 200], bv_bakehouse_sales_franchises = [835, 317, 200, 200], bv_bakehouse_sales_customers = [589, 517, 200, 200], bv_bakehouse_sales_suppliers = [1350, 300, 200, 200]);

ALTER VIEW iv_bakehouse_sales_info
 CACHE FULL
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

