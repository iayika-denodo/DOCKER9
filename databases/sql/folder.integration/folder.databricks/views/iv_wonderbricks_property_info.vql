CREATE OR REPLACE VIEW iv_wonderbricks_property_info FOLDER = '/integration/databricks' AS SELECT bv_wonderbricks_hosts.host_id AS host_id, bv_wonderbricks_properties.destination_id AS destination_id, bv_wonderbricks_hosts.name AS name, bv_wonderbricks_hosts.email AS email, bv_wonderbricks_hosts.phone AS phone, bv_wonderbricks_hosts.is_verified AS is_verified, bv_wonderbricks_hosts.is_active AS is_active, bv_wonderbricks_hosts.rating AS rating, bv_wonderbricks_hosts.country AS country, bv_wonderbricks_hosts.joined_at AS joined_at, bv_wonderbricks_properties.property_id AS property_id, bv_wonderbricks_properties.title AS title, bv_wonderbricks_properties.description AS description, bv_wonderbricks_properties.base_price AS base_price, bv_wonderbricks_properties.property_type AS property_type, bv_wonderbricks_properties.max_guests AS max_guests, bv_wonderbricks_properties.bedrooms AS bedrooms, bv_wonderbricks_properties.bathrooms AS bathrooms, bv_wonderbricks_properties.property_latitude AS property_latitude, bv_wonderbricks_properties.property_longitude AS property_longitude, bv_wonderbricks_properties.created_at AS created_at FROM bv_wonderbricks_hosts AS bv_wonderbricks_hosts INNER JOIN bv_wonderbricks_properties AS bv_wonderbricks_properties ON bv_wonderbricks_hosts.host_id = bv_wonderbricks_properties.host_id ;

ALTER VIEW iv_wonderbricks_property_info
 LAYOUT (bv_wonderbricks_hosts = [20, 20, 200, 200], bv_wonderbricks_properties = [320, 70, 200, 200]);

ALTER VIEW iv_wonderbricks_property_info
 CACHE FULL
    BATCHSIZEINCACHE DEFAULT TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE RECREATE INCREMENTAL_LOAD;

