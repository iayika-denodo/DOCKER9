CREATE OR REPLACE GLOBAL_SECURITY_POLICY global_test
    ENABLED = TRUE
    AUDIENCE (
        ALL
    )
    ELEMENTS (
        VIEWS TAGGED ANY  (test)
    )
    RESTRICTION (
        FILTER = ''
        MASKING ANY (test) WITH (HIDE) (numbers WITH REDACT, datetimes WITH DEFAULT, texts WITH HIDE) 
    );

